CORS_ORIGIN=https://your-frontend-domain.example.com
JWT_ACCESS_EXPIRY=7d
JWT_ACCESS_SECRET=replace-with-a-long-random-secret
JWT_REFRESH_EXPIRY=30d
JWT_REFRESH_SECRET=replace-with-a-long-random-secret
MAIL_FROM=onboarding@resend.dev
MAIL_FROM_NAME="Property Manager"
NODE_ENV=production
PORT=5000
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
Resend_api_key=

# Postgres (Supabase) connection string used by Prisma.
# Percent-encode any special characters in the password (e.g. "@" -> "%40").
# Use the Supavisor session pooler (port 5432) so `prisma migrate` works directly.
# connection_limit keeps the app's own pool under the pooler's session client cap.
DATABASE_URL="postgresql://<user>:<password>@<host>:5432/postgres?sslmode=require&connection_limit=5&pool_timeout=20"

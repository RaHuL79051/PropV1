CORS_ORIGIN=https://your-frontend-domain.example.com
JWT_ACCESS_EXPIRY=7d
JWT_ACCESS_SECRET=replace-with-a-long-random-secret
JWT_REFRESH_EXPIRY=30d
JWT_REFRESH_SECRET=replace-with-a-long-random-secret
MAIL_FROM=onboarding@resend.dev
MAIL_FROM_NAME="Property Manager"
NODE_ENV=production
PORT=5000
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
Resend_api_key=

# Postgres (Supabase) connection strings used by Prisma.
# Percent-encode any special characters in the password (e.g. "@" -> "%40").
#
# DATABASE_URL — runtime queries. Use the Transaction Pooler (port 6543).
# `pgbouncer=true` disables prepared statements (required for pgBouncer transaction mode).
# `connection_limit=1` is the Prisma-recommended default for serverless (Vercel);
# raise to 10 for a long-running single-instance server (Render, Fly, a container).
DATABASE_URL="postgresql://<user>:<password>@<host>:6543/postgres?pgbouncer=true&connection_limit=1&pool_timeout=20"

# DIRECT_URL — migrations only. Use the Session Pooler (port 5432).
# `prisma migrate` cannot run through the transaction pooler.
DIRECT_URL="postgresql://<user>:<password>@<host>:5432/postgres?sslmode=require"

# CRON_SECRET — shared secret Vercel Cron includes in the `Authorization` header
# when firing scheduled jobs. Set it in the Vercel dashboard; also required
# locally if you want to test the /api/cron/monthly-billing endpoint by hand.
CRON_SECRET=replace-with-a-long-random-secret
